# Proteksi File Sensitif dari Akses HTTP Publik
<FilesMatch "^\.(env|git|htaccess|htpasswd)|.*\.(sql|pem|key|log|yml|yaml)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

Options -Indexes
